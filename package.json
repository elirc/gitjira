{
  "name": "gitjira-rebuild",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local issue tracker built through Astra and Sol adversarial review",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs && node tests/ui-races.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": { "express": "5.2.1" },
  "devDependencies": { "playwright": "1.63.0" }
}
