// LEARN: the schema file is the single source of truth for the database.
// Change it, generate a migration, review the SQL in the PR like any other
// code. "What does the database look like?" is answered here, in version
// control — never by poking at a live server.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  memberships    ProjectMember[]
  refreshTokens  RefreshToken[]
  ledProjects    Project[]       @relation("ProjectLead")
  assignedIssues Issue[]         @relation("Assignee")
  reportedIssues Issue[]         @relation("Reporter")
  comments       Comment[]
  activityEvents ActivityEvent[]
  attachments    Attachment[]
  savedFilters   SavedFilter[]
  watchers       Watcher[]
  notifications  Notification[]
}

model Project {
  id           String   @id @default(cuid())
  key          String   @unique // e.g. "GJ" — short, human, used in issue keys
  name         String
  description  String?
  leadId       String
  issueCounter Int      @default(0)
  createdAt    DateTime @default(now())

  lead    User             @relation("ProjectLead", fields: [leadId], references: [id])
  members ProjectMember[]
  columns WorkflowColumn[]
  issues  Issue[]
  sprints Sprint[]
}

// LEARN: a join table with payload. Many-to-many between User and Project,
// but the *relationship itself* has data (the role). Modeling the
// relationship as its own entity is what makes per-project roles possible.
model ProjectMember {
  projectId String
  userId    String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

// LEARN: we store a HASH of the refresh token, never the token itself.
// If this table leaks, the attacker holds fingerprints, not keys — same
// reasoning as password hashing. `familyId` groups tokens descended from
// one login, so detecting a replayed (already-rotated) token lets us
// revoke the entire session lineage at once.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

enum ColumnCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum Priority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

model WorkflowColumn {
  id        String         @id @default(cuid())
  projectId String
  name      String
  position  Int
  category  ColumnCategory

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

// LEARN: `number` is per-project (GJ-101, WEB-101 can coexist) — enforced by
// the compound unique, allocated from Project.issueCounter. The display key
// "GJ-101" is DERIVED (project.key + number), never stored: storing it would
// mean two sources of truth that can disagree.
model Issue {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  type        IssueType @default(TASK)
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  columnId    String
  assigneeId  String?
  reporterId  String
  labels      String[]  @default([])
  parentId    String?
  position    String    @default("U")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // LEARN: Prisma has no native tsvector type, so we declare it as Unsupported
  // (Prisma tracks the column but won't let JS read/write it directly). The
  // actual column is a GENERATED STORED tsvector defined in the migration SQL
  // — Postgres recomputes it automatically whenever title/description change,
  // so there's nothing to keep in sync in app code.
  searchVector Unsupported("tsvector")?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column         WorkflowColumn  @relation(fields: [columnId], references: [id])
  assignee       User?           @relation("Assignee", fields: [assigneeId], references: [id])
  reporter       User            @relation("Reporter", fields: [reporterId], references: [id])
  parent         Issue?          @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  children       Issue[]         @relation("SubTasks")
  comments       Comment[]
  activityEvents ActivityEvent[]
  attachments    Attachment[]
  sprint         Sprint?         @relation(fields: [sprintId], references: [id])
  sprintId       String?
  storyPoints    Int?
  watchers       Watcher[]

  @@unique([projectId, number])
  @@index([projectId, columnId])
  // LEARN (sprint 12): the board list filters by projectId and orders by
  // createdAt DESC, id DESC. Without this the planner filters on the
  // projectId+columnId index and then TOP-N HEAPSORTs the result (measured:
  // Sort node in EXPLAIN). A composite index whose column order MATCHES the
  // query (equality column first, then the sort columns in sort order) lets
  // Postgres walk the index already-ordered and stop at LIMIT — no sort step.
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
}

model Comment {
  id        String    @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// LEARN: event-sourcing-lite. Rather than only storing the CURRENT state, we
// append an immutable record every time something notable happens. It powers
// the activity feed now, and it is the exact seam sprint 08 (emit to sockets)
// and sprint 09 (fan out notifications) attach to. `payload` is JSON so new
// event kinds don't need a migration.
model ActivityEvent {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String
  kind      String
  payload   Json
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  // LEARN (sprint 12): the feed reads one issue's events newest-first. The
  // plain issueId index found the rows but still sorted them by createdAt.
  // (issueId, createdAt DESC) serves the filter AND the order in one walk.
  @@index([issueId, createdAt(sort: Desc)])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  uploaderId String
  filename   String
  size       Int
  mimeType   String
  storageKey String
  createdAt  DateTime @default(now())

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  jql       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

model Sprint {
  id        String      @id @default(cuid())
  projectId String
  name      String
  goal      String?
  state     SprintState @default(PLANNED)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

model Watcher {
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  issueId   String?
  actorId   String?
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // LEARN: the idempotency key. A job may run more than once (at-least-once
  // delivery), so the fan-out derives a stable key per (recipient, event) and
  // stores it UNIQUE. A retried job that tries to insert the same key hits the
  // constraint — which we treat as "already delivered", not an error. This is
  // how you make a non-idempotent-looking operation idempotent.
  dedupeKey String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
