// LEARN: the schema file is the single source of truth for the database.
// Change it, generate a migration, review the SQL in the PR like any other
// code. "What does the database look like?" is answered here, in version
// control — never by poking at a live server.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  memberships    ProjectMember[]
  refreshTokens  RefreshToken[]
  ledProjects    Project[]       @relation("ProjectLead")
  assignedIssues Issue[]         @relation("Assignee")
  reportedIssues Issue[]         @relation("Reporter")
}

model Project {
  id           String   @id @default(cuid())
  key          String   @unique // e.g. "GJ" — short, human, used in issue keys
  name         String
  description  String?
  leadId       String
  issueCounter Int      @default(0)
  createdAt    DateTime @default(now())

  lead    User             @relation("ProjectLead", fields: [leadId], references: [id])
  members ProjectMember[]
  columns WorkflowColumn[]
  issues  Issue[]
}

// LEARN: a join table with payload. Many-to-many between User and Project,
// but the *relationship itself* has data (the role). Modeling the
// relationship as its own entity is what makes per-project roles possible.
model ProjectMember {
  projectId String
  userId    String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

// LEARN: we store a HASH of the refresh token, never the token itself.
// If this table leaks, the attacker holds fingerprints, not keys — same
// reasoning as password hashing. `familyId` groups tokens descended from
// one login, so detecting a replayed (already-rotated) token lets us
// revoke the entire session lineage at once.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

enum ColumnCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum Priority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

model WorkflowColumn {
  id        String         @id @default(cuid())
  projectId String
  name      String
  position  Int
  category  ColumnCategory

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

// LEARN: `number` is per-project (GJ-101, WEB-101 can coexist) — enforced by
// the compound unique, allocated from Project.issueCounter. The display key
// "GJ-101" is DERIVED (project.key + number), never stored: storing it would
// mean two sources of truth that can disagree.
model Issue {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  type        IssueType @default(TASK)
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  columnId    String
  assigneeId  String?
  reporterId  String
  labels      String[]  @default([])
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column   WorkflowColumn @relation(fields: [columnId], references: [id])
  assignee User?          @relation("Assignee", fields: [assigneeId], references: [id])
  reporter User           @relation("Reporter", fields: [reporterId], references: [id])

  @@unique([projectId, number])
  @@index([projectId, columnId])
}
