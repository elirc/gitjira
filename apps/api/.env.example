# LEARN (sprint 15): the documented inventory of every env var the API reads.
# The env validator (src/lib/env.js) enforces this at boot. Copy to .env and fill in.

# Required — boot fails without these.
DATABASE_URL=postgresql://gitjira:gitjira_dev@localhost:5432/gitjira
JWT_SECRET=change-me-to-a-long-random-string

# Optional — defaults shown.
PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=development
LOG_LEVEL=info
